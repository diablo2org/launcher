{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diablo2.org/schema/file-manifest/1.json",
  "title": "File manifest",
  "description": "The exact set of files for one channel or component version. See docs/SPEC.md section 4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "server",
    "version",
    "files"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": 1
    },
    "server": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "description": "Relative to the server folder, forward slashes only. The launcher also rejects Windows reserved names, trailing dots or spaces, and case-insensitive duplicates; see SPEC section 4.",
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[^\\\\:*?\"<>|]+$",
            "not": {
              "anyOf": [
                {
                  "pattern": "^/"
                },
                {
                  "pattern": "(^|/)\\.\\.?(/|$)"
                }
              ]
            }
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^https://[^\\s]+$",
              "maxLength": 2048
            }
          },
          "mode": {
            "enum": [
              "replace",
              "once",
              "delete"
            ],
            "default": "replace"
          }
        },
        "if": {
          "properties": {
            "mode": {
              "const": "delete"
            }
          },
          "required": [
            "mode"
          ]
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "size"
                ]
              },
              {
                "required": [
                  "sha256"
                ]
              },
              {
                "required": [
                  "urls"
                ]
              }
            ]
          }
        },
        "else": {
          "required": [
            "size",
            "sha256",
            "urls"
          ]
        }
      }
    }
  }
}
